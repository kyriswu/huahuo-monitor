      "targets": [
        {
          "refId": "A",
          "expr": "(kube_pod_status_phase{job=\"kube-state-metrics\",namespace=~\"$namespace\"} == 1) * on (namespace,pod,uid) group_left(node) kube_pod_info{job=\"kube-state-metrics\",namespace=~\"$namespace\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
