        ],
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "namespace",
                "pod",
                "node",
                "phase"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "node": 2,
              "phase": 3
            },
            "renameByName": {
              "namespace": "命名空间",
              "pod": "Pod",
              "node": "节点",
              "phase": "阶段"
            }
          }
        }
      ]
    },
