        ],
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "job",
                "role",
                "instance",
                "env",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "job": 0,
              "role": 1,
              "instance": 2,
              "env": 3,
              "Value": 4
            },
            "renameByName": {
              "job": "采集任务",
              "role": "角色",
              "instance": "地址",
              "env": "环境",
              "Value": "采集状态"
