      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(max_over_time({service=\"rds-slow-sql\",env=~\"$env\",rds_instance=~\"$rds_instance\",database=~\"$database\"} | json | __error__=\"\" | probe=\"$probe\" | query_id=~\"${query_id:raw}\" | unwrap elapsed_ms | __error__=\"\"[$__range]))",
          "queryType": "instant",
          "editorMode": "code",
          "legendFormat": "",
          "direction": "backward",
          "maxLines": 500
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "horizontal",
        "justifyMode": "center"
      }
    },
