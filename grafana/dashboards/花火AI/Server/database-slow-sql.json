{
  "uid": "database-slow-sql",
  "title": "数据库慢查询",
  "description": "RDS 数据库侧慢日志：采集状态、记录排行、精确记录耗时与脱敏 SQL；默认排除监控验证探针。",
  "tags": [
    "花火AI"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "环境",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"monitoring\",service=\"rds-slow-logs\"},env)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(up{job=\"monitoring\",service=\"rds-slow-logs\"},env)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "test"
          ],
          "value": [
            "test"
          ]
        },
        "options": []
      },
      {
        "name": "rds_instance",
        "label": "RDS 实例",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "rds_instance",
          "stream": "{service=\"rds-slow-sql\",env=~\"$env\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "database",
        "label": "数据库",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "database",
          "stream": "{service=\"rds-slow-sql\",env=~\"$env\",rds_instance=~\"$rds_instance\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "probe",
        "label": "数据范围",
        "type": "custom",
        "multi": false,
        "query": "业务慢SQL : false,验证探针 : true",
        "current": {
          "selected": true,
          "text": "业务慢SQL",
          "value": "false"
        },
        "options": [
          {
            "text": "业务慢SQL",
            "value": "false",
            "selected": true
          },
          {
            "text": "验证探针",
            "value": "true",
            "selected": false
          }
        ]
      },
      {
        "name": "query_id",
        "label": "SQL 标识（正则）",
        "type": "textbox",
        "query": ".*",
        "current": {
          "selected": true,
          "text": ".*",
          "value": ".*"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "慢日志同步状态",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "检查所选环境的采集器。正常表示在时间范围结束时刻可访问，且此前 3 分钟成功同步 RDS 慢日志。请切换到最近 6 小时或将结束时间设为 now 来查看当前状态。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "所选时刻无状态",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "未同步",
                  "color": "red"
                },
                "1": {
                  "text": "正常",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"monitoring\",service=\"rds-slow-logs\",env=~\"$env\"} * (time() - rds_slow_logs_last_success_timestamp_seconds{job=\"monitoring\",service=\"rds-slow-logs\",env=~\"$env\"} < bool 180)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "horizontal",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "title": "时段慢SQL记录数",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "所选范围已采集的 RDS 慢日志记录数。API 可能聚合多次执行，记录数不等同于精确 SQL 执行次数。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "暂无记录",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"rds-slow-sql\",env=~\"$env\",rds_instance=~\"$rds_instance\",database=~\"$database\"} | json | __error__=\"\" | probe=\"$probe\" | query_id=~\"${query_id:raw}\"[$__range])) or vector(0)",
          "queryType": "instant",
          "editorMode": "code",
          "legendFormat": "",
          "direction": "backward",
          "maxLines": 500
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "horizontal",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "title": "涉及 SQL 摘要",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "按 RDS SQLHash / 采集器 query_id 区分的 SQL 摘要数。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "暂无记录",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (query_id) (count_over_time({service=\"rds-slow-sql\",env=~\"$env\",rds_instance=~\"$rds_instance\",database=~\"$database\"} | json | __error__=\"\" | probe=\"$probe\" | query_id=~\"${query_id:raw}\"[$__range]))) or vector(0)",
          "queryType": "instant",
          "editorMode": "code",
          "legendFormat": "",
          "direction": "backward",
          "maxLines": 500
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "horizontal",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "title": "最长记录耗时",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
