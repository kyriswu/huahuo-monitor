      "description": "当前筛选范围内，RDS 每条慢日志记录 QueryTimeMS 的最大值。",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "无慢SQL",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
