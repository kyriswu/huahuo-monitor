          "refId": "A",
          "expr": "label_join(sum by (status,service,role,method,route) (increase(http_requests_total{job=\"application\",service=~\"${service:pipe}\",exported_env=~\"$env\",host=~\"$host\",traffic=~\"${traffic:pipe}\",route=~\"${business:pipe}\",role=~\"$role\",status=~\"5..\",method=~\"$method\",route=~\"$route\"}[$__range])) > 0,\"request\",\" · \",\"service\",\"role\",\"method\",\"route\") or label_replace(label_replace((0 * count(up{job=\"application\",service=~\"${service:pipe}\",env=~\"$env\",host=~\"$host\",role=~\"$role\"})),\"status\",\"500\",\"__name__\",\".*\"),\"request\",\"暂无记录\",\"status\",\".*\") or label_replace(label_replace((0 * count(up{job=\"application\",service=~\"${service:pipe}\",env=~\"$env\",host=~\"$host\",role=~\"$role\"})),\"status\",\"501\",\"__name__\",\".*\"),\"request\",\"暂无记录\",\"status\",\".*\") or label_replace(label_replace((0 * count(up{job=\"application\",service=~\"${service:pipe}\",env=~\"$env\",host=~\"$host\",role=~\"$role\"})),\"status\",\"502\",\"__name__\",\".*\"),\"request\",\"暂无记录\",\"status\",\".*\") or label_replace(label_replace((0 * count(up{job=\"application\",service=~\"${service:pipe}\",env=~\"$env\",host=~\"$host\",role=~\"$role\"})),\"status\",\"503\",\"__name__\",\".*\"),\"request\",\"暂无记录\",\"status\",\".*\") or label_replace(label_replace((0 * count(up{job=\"application\",service=~\"${service:pipe}\",env=~\"$env\",host=~\"$host\",role=~\"$role\"})),\"status\",\"504\",\"__name__\",\".*\"),\"request\",\"暂无记录\",\"status\",\".*\")",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
