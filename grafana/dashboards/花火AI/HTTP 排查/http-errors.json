    {
      "id": 4,
      "title": "5xx 状态码排行 · 悬停查看接口，点击筛选",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "按错误总数降序。悬停显示各角色、方法、接口的贡献；点击柱子筛选下方列表。常见状态码无记录时为 0。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "暂无数据",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0,
          "min": 0,
          "links": [
            {
              "title": "按这个状态码查看接口和请求列表",
              "url": "/d/http-errors?from=${__from}&to=${__to}&${env:queryparam}&${service:queryparam}&${traffic:queryparam}&${business:queryparam}&${host:queryparam}&${role:queryparam}&${method:queryparam}&${route:queryparam}&var-status=${__data.fields[\"状态码\"]:percentencode}",
              "oneClick": true
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "合计"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": true,
                  "legend": true,
                  "tooltip": false
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "暂无记录"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              }
            ]
          }
        ]
      },
      "targets": [
